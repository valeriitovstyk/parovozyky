+// Oracle (P2): Turbo C runtime rand()/srand() instead of the platform ones.
+//
+// ShortLine was built with Turbo C, whose rand() is a 32-bit LCG returning
+// 15 bits:   seed = seed * 22695477 + 1;  return (seed >> 16) & 0x7FFF;
+// srand() takes a 16-bit `unsigned`. reSL calls the platform std::rand()
+// (31 bits on macOS/glibc), which changes the probability of expressions like
+// `(rand() & 0xFFFF) < p` (see docs/fidelity.md, F1).
+//
+// These definitions in the main executable take precedence over libc's ones,
+// and std::rand/std::srand are `using ::rand/::srand`.
+
+#include <cstdint>
+
+namespace {
+std::uint32_t g_tcSeed = 1;
+}
+
+extern "C" int rand(void)
+{
+    g_tcSeed = g_tcSeed * 22695477u + 1u;
+    return static_cast<int>((g_tcSeed >> 16) & 0x7FFF);
+}
+
+extern "C" void srand(unsigned seed)
+{
+    g_tcSeed = seed & 0xFFFFu;
+}
+
+namespace resl {
+
+std::uint32_t oracleRandState()
+{
+    return g_tcSeed;
+}
+
+} // namespace resl
