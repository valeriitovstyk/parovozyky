--- /dev/null
+++ b/src/system/driver/headless/mouse.cpp
@@ -0,0 +1,85 @@
+#include "mouse.h"
+
+#include "driver.h"
+
+#include <graphics/vga.h>
+
+#include <algorithm>
+#include <utility>
+
+namespace resl {
+
+void MouseDriver::setPosition(int x, int y)
+{
+    // reSL issues a motion event manually here (the demo mode relies on it)
+    onMouseMove(x, y);
+}
+
+MouseDriver::HandlerHolder::HandlerHolder() noexcept
+    : m_iter(Driver::instance().mouse().m_handlers.end())
+{
+}
+
+MouseDriver::HandlerHolder::HandlerHolder(HandlerStorageT::iterator iter) noexcept
+    : m_iter(iter)
+{
+}
+
+MouseDriver::HandlerHolder::~HandlerHolder()
+{
+    if (m_iter != Driver::instance().mouse().m_handlers.end())
+        Driver::instance().mouse().m_handlers.erase(m_iter);
+}
+
+MouseDriver::HandlerHolder::HandlerHolder(HandlerHolder&& other) noexcept
+    : m_iter(Driver::instance().mouse().m_handlers.end())
+{
+    std::swap(m_iter, other.m_iter);
+}
+
+MouseDriver::HandlerHolder&
+MouseDriver::HandlerHolder::operator=(HandlerHolder&& other) noexcept
+{
+    std::swap(m_iter, other.m_iter);
+    return *this;
+}
+
+MouseDriver::HandlerHolder MouseDriver::addHandler(MouseHandler hdl)
+{
+    m_handlers.push_front(hdl);
+    return { m_handlers.begin() };
+}
+
+void MouseDriver::handle(
+    std::uint16_t flags, std::uint16_t btnState, std::int16_t x, std::int16_t y)
+{
+    if (m_handlers.empty()) [[unlikely]]
+        return;
+
+    MouseEvent e(flags, btnState, x, y);
+    for (MouseHandler& handler : m_handlers) {
+        handler(e);
+        if (!e.propagation())
+            break;
+    }
+}
+
+void MouseDriver::onMouseMove(int x, int y)
+{
+    x = std::min(x, LOGICAL_SCREEN_WIDTH);
+    y = std::min(y, LOGICAL_SCREEN_HEIGHT);
+    handle(0, m_mouseButtonState, static_cast<std::int16_t>(x), static_cast<std::int16_t>(y));
+    m_cursorX = x;
+    m_cursorY = y;
+}
+
+void MouseDriver::scriptEvent(std::uint16_t flags, std::uint16_t buttons, int x, int y)
+{
+    m_mouseButtonState = buttons;
+    if (!flags)
+        onMouseMove(x, y);
+    else
+        handle(flags, m_mouseButtonState, static_cast<std::int16_t>(x), static_cast<std::int16_t>(y));
+}
+
+} // namespace resl
diff --git a/src/system/driver/headless/mouse.h b/src/system/driver/headless/mouse.h
new file mode 100644
index 0000000..67c4f70
--- /dev/null
+++ b/src/system/driver/headless/mouse.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include "touch_context.h" // IWYU pragma: export
+#include <system/mouse.h>
+
+#include <cstdint>
+#include <list>
+
+namespace resl {
+
+// Headless replacement of the SDL mouse driver. Mouse events come from the
+// oracle input script and are dispatched exactly like reSL dispatches SDL
+// events: handlers are called in LIFO order of registration until one of them
+// stops the propagation.
+class MouseDriver {
+    using HandlerStorageT = std::list<MouseHandler>;
+
+public:
+    class [[nodiscard]] HandlerHolder {
+    public:
+        HandlerHolder() noexcept;
+        HandlerHolder(HandlerStorageT::iterator) noexcept;
+        ~HandlerHolder();
+
+        HandlerHolder(HandlerHolder&&) noexcept;
+        HandlerHolder& operator=(HandlerHolder&&) noexcept;
+
+        HandlerHolder(const HandlerHolder&) = delete;
+        HandlerHolder& operator=(const HandlerHolder&) = delete;
+
+    private:
+        HandlerStorageT::iterator m_iter;
+    };
+
+    class [[nodiscard]] TouchContextProviderHolder {
+    public:
+        TouchContextProviderHolder() = default;
+        TouchContextProviderHolder(const TouchContextProviderHolder&) = delete;
+        TouchContextProviderHolder& operator=(const TouchContextProviderHolder&) = delete;
+    };
+
+    void setCursorVisibility(bool v) { m_cursorVisible = v; }
+    bool cursorVisible() const noexcept { return m_cursorVisible; }
+
+    int cursorX() const { return m_cursorX; }
+    int cursorY() const { return m_cursorY; }
+    void setPosition(int x, int y);
+
+    HandlerHolder addHandler(MouseHandler hdl);
+    TouchContextProviderHolder setTouchContextProvider(TouchContextProvider&) { return {}; }
+
+    bool isTouchDevice() const noexcept { return false; }
+
+    // Scripted event: the same as SDL button/motion events after conversion
+    // to logical coordinates. flags == 0 means a motion event.
+    void scriptEvent(std::uint16_t flags, std::uint16_t buttons, int x, int y);
+
+    std::uint16_t buttonState() const { return m_mouseButtonState; }
+
+private:
+    void handle(std::uint16_t flags, std::uint16_t btnState,
+                std::int16_t x, std::int16_t y);
+    void onMouseMove(int x, int y);
+
+    HandlerStorageT m_handlers;
+    std::uint16_t m_mouseButtonState = 0;
+
+    int m_cursorX = 0;
+    int m_cursorY = 0;
+    bool m_cursorVisible = false;
+};
+
+} // namespace resl
diff --git a/src/system/driver/headless/oracle.cpp b/src/system/driver/headless/oracle.cpp
new file mode 100644
index 0000000..f23ad9b
--- /dev/null
+++ b/src/system/driver/headless/oracle.cpp
@@ -0,0 +1,292 @@
+// ShortLine oracle runtime.
+//
+// Environment:
+//   RESL_SEED       initial srand() seed (Turbo C srand takes 16 bits)
+//   RESL_SCRIPT     input script, one event per line:
+//                     <t_us> mouse <flags> <buttons> <x> <y>
+//                     <t_us> key <scancode> <down:0|1>
+//   RESL_TRACE      output trace file (text, see docs/trace-format.md)
+//   RESL_STOP_AT    virtual time in microseconds to stop at
+//   RESL_DUMP_EVERY full state dump period in microseconds (default 1000000, 0 = off)
+//   RESL_SCREENSHOT_EVERY  write <trace>.<t>.ppm screenshots with this period (us, 0 = off)
+//   RESL_CHAIN_EVERY  0 (default): one "H" line per state change;
+//                     N > 0: state changes are folded into a running chain hash
+//                     and one "C" line is written every N microseconds
+
+#include "oracle.h"
+
+#include "driver.h"
+#include "state_dump.h"
+
+#include <system/keyboard.h>
+
+#include <cassert>
+#include <cinttypes>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace resl::oracle {
+
+namespace {
+
+    std::int64_t g_nowUs = 0;
+
+    struct InputEvent {
+        std::int64_t t;
+        bool isKey;
+        int a, b, c, d; // mouse: flags, buttons, x, y; key: scancode, down
+    };
+
+    std::vector<InputEvent> g_script;
+    std::size_t g_nextEvent = 0;
+
+    std::FILE* g_trace = nullptr;
+    std::int64_t g_stopAt = -1;
+    std::int64_t g_dumpEvery = 1000000;
+    std::int64_t g_nextDump = 0;
+    std::int64_t g_screenshotEvery = 0;
+    std::int64_t g_nextScreenshot = 0;
+    std::string g_tracePath;
+
+    std::int64_t g_chainEvery = 0;
+    std::int64_t g_nextChain = 0;
+    std::uint32_t g_chain = 2166136261u;
+    unsigned g_chainSteps = 0;
+
+    std::uint32_t fnv(std::uint32_t h, std::uint32_t v)
+    {
+        h ^= v;
+        return h * 16777619u;
+    }
+
+    std::uint32_t g_lastHash = 0;
+    bool g_haveHash = false;
+    unsigned g_resumeCount = 0;
+
+    std::int64_t envInt(const char* name, std::int64_t def)
+    {
+        const char* v = std::getenv(name);
+        if (!v || !*v)
+            return def;
+        return std::strtoll(v, nullptr, 10);
+    }
+
+    void loadScript(const char* path)
+    {
+        std::FILE* f = std::fopen(path, "r");
+        if (!f) {
+            std::fprintf(stderr, "oracle: unable to open script %s\n", path);
+            std::exit(2);
+        }
+        char line[256];
+        while (std::fgets(line, sizeof(line), f)) {
+            if (line[0] == '#' || line[0] == '\n')
+                continue;
+            InputEvent e = {};
+            char kind[16];
+            long long t = 0;
+            if (std::sscanf(line, "%lld %15s", &t, kind) != 2)
+                continue;
+            e.t = t;
+            if (!std::strcmp(kind, "mouse")) {
+                if (std::sscanf(line, "%*lld %*s %d %d %d %d", &e.a, &e.b, &e.c, &e.d) != 4) {
+                    std::fprintf(stderr, "oracle: bad script line: %s", line);
+                    std::exit(2);
+                }
+                e.isKey = false;
+            } else if (!std::strcmp(kind, "key")) {
+                if (std::sscanf(line, "%*lld %*s %d %d", &e.a, &e.b) != 2) {
+                    std::fprintf(stderr, "oracle: bad script line: %s", line);
+                    std::exit(2);
+                }
+                e.isKey = true;
+            } else {
+                std::fprintf(stderr, "oracle: unknown script event: %s", line);
+                std::exit(2);
+            }
+            if (!g_script.empty() && g_script.back().t > e.t) {
+                std::fprintf(stderr, "oracle: script is not sorted by time\n");
+                std::exit(2);
+            }
+            g_script.push_back(e);
+        }
+        std::fclose(f);
+    }
+
+    void writeScreenshot()
+    {
+        static std::uint32_t pixels[LOGICAL_SCREEN_WIDTH * LOGICAL_SCREEN_HEIGHT];
+        Driver::instance().vga().renderScreen(pixels);
+        char name[512];
+        std::snprintf(name, sizeof(name), "%s.%010" PRId64 ".ppm", g_tracePath.c_str(), g_nowUs);
+        std::FILE* f = std::fopen(name, "wb");
+        if (!f)
+            return;
+        std::fprintf(f, "P6\n%d %d\n255\n", LOGICAL_SCREEN_WIDTH, LOGICAL_SCREEN_HEIGHT);
+        for (std::uint32_t p : pixels) {
+            const unsigned char rgb[3] = {
+                static_cast<unsigned char>(p >> 16), static_cast<unsigned char>(p >> 8),
+                static_cast<unsigned char>(p)
+            };
+            std::fwrite(rgb, 1, 3, f);
+        }
+        std::fclose(f);
+    }
+
+    void finish(const char* reason)
+    {
+        if (g_trace) {
+            std::string dump = dumpStateJson();
+            std::fprintf(g_trace, "F %" PRId64 " %s\n", g_nowUs, dump.c_str());
+            if (g_chainEvery > 0)
+                std::fprintf(g_trace, "C %" PRId64 " %u %08x\n", g_nowUs, g_chainSteps, g_chain);
+            std::fprintf(g_trace, "E %" PRId64 " %s %08x\n", g_nowUs, reason, stateHash());
+            std::fclose(g_trace);
+            g_trace = nullptr;
+        }
+    }
+
+    void checkStop()
+    {
+        if (g_stopAt >= 0 && g_nowUs >= g_stopAt) {
+            finish("stop");
+            std::_Exit(0);
+        }
+    }
+
+    void onExit()
+    {
+        finish("exit");
+    }
+
+} // namespace
+
+VirtualClock::time_point VirtualClock::now() noexcept
+{
+    return time_point(duration(g_nowUs));
+}
+
+void advanceTo(VirtualClock::time_point t)
+{
+    const std::int64_t us = t.time_since_epoch().count();
+    if (us > g_nowUs)
+        g_nowUs = us;
+}
+
+void advanceBy(VirtualClock::duration d)
+{
+    assert(d.count() >= 0);
+    g_nowUs += d.count();
+}
+
+void init(int, char*[])
+{
+    if (const char* script = std::getenv("RESL_SCRIPT"); script && *script)
+        loadScript(script);
+    g_stopAt = envInt("RESL_STOP_AT", -1);
+    g_dumpEvery = envInt("RESL_DUMP_EVERY", 1000000);
+    g_nextDump = 0;
+    g_screenshotEvery = envInt("RESL_SCREENSHOT_EVERY", 0);
+    g_chainEvery = envInt("RESL_CHAIN_EVERY", 0);
+    if (const char* tracePath = std::getenv("RESL_TRACE"); tracePath && *tracePath) {
+        g_tracePath = tracePath;
+        g_trace = std::fopen(tracePath, "w");
+        if (!g_trace) {
+            std::fprintf(stderr, "oracle: unable to open trace %s\n", tracePath);
+            std::exit(2);
+        }
+        std::fprintf(g_trace, "V shortline-trace 1\n");
+        std::fprintf(g_trace, "L %d\n", entrancesBeforeRails());
+    }
+    std::atexit(&onExit);
+}
+
+void onTaskAdded(unsigned taskId)
+{
+    if (g_trace)
+        std::fprintf(g_trace, "T %" PRId64 " %u\n", g_nowUs, taskId);
+}
+
+void onTaskResumed(unsigned taskId)
+{
+    ++g_resumeCount;
+    if (g_trace) {
+        const std::uint32_t h = stateHash();
+        if (!g_haveHash || h != g_lastHash) {
+            if (g_chainEvery > 0) {
+                g_chain = fnv(g_chain, static_cast<std::uint32_t>(g_nowUs & 0xFFFFFFFF));
+                g_chain = fnv(g_chain, static_cast<std::uint32_t>(g_nowUs >> 32));
+                g_chain = fnv(g_chain, taskId);
+                g_chain = fnv(g_chain, h);
+                ++g_chainSteps;
+            } else
+                std::fprintf(g_trace, "H %" PRId64 " %u %08x\n", g_nowUs, taskId, h);
+            g_lastHash = h;
+            g_haveHash = true;
+        }
+        if (g_chainEvery > 0 && g_nowUs >= g_nextChain) {
+            std::fprintf(g_trace, "C %" PRId64 " %u %08x\n", g_nowUs, g_chainSteps, g_chain);
+            while (g_nextChain <= g_nowUs)
+                g_nextChain += g_chainEvery;
+        }
+        if (g_dumpEvery > 0 && g_nowUs >= g_nextDump) {
+            std::string dump = dumpStateDeltaJson();
+            std::fprintf(g_trace, "D %" PRId64 " %s\n", g_nowUs, dump.c_str());
+            while (g_nextDump <= g_nowUs)
+                g_nextDump += g_dumpEvery;
+        }
+    }
+    checkStop();
+}
+
+void onFrame()
+{
+    if (g_screenshotEvery > 0 && g_nowUs >= g_nextScreenshot && !g_tracePath.empty()) {
+        writeScreenshot();
+        while (g_nextScreenshot <= g_nowUs)
+            g_nextScreenshot += g_screenshotEvery;
+    }
+    checkStop();
+}
+
+void onSound(std::uint16_t freq)
+{
+    if (g_trace)
+        std::fprintf(g_trace, "S %" PRId64 " %u\n", g_nowUs, static_cast<unsigned>(freq));
+}
+
+void onStatusMessage(const char* msg)
+{
+    if (g_trace)
+        std::fprintf(g_trace, "M %" PRId64 " %s\n", g_nowUs, msg);
+}
+
+void undefinedBehavior(const char* what)
+{
+    if (g_trace)
+        std::fprintf(g_trace, "U %" PRId64 " %s\n", g_nowUs, what);
+    finish("ub");
+    std::_Exit(0);
+}
+
+void deliverInput()
+{
+    while (g_nextEvent < g_script.size() && g_script[g_nextEvent].t <= g_nowUs) {
+        const InputEvent& e = g_script[g_nextEvent++];
+        if (g_trace)
+            std::fprintf(g_trace, "I %" PRId64 " %s %d %d %d %d\n", g_nowUs,
+                         e.isKey ? "key" : "mouse", e.a, e.b, e.c, e.d);
+        if (e.isKey) {
+            KeyboardHandler hdl = Driver::instance().keyboardHandler();
+            if (hdl && e.a)
+                hdl(static_cast<std::uint8_t>(e.a | (e.b ? 0 : g_keyReleasedFlag)));
+        } else
+            Driver::instance().mouse().scriptEvent(
+                static_cast<std::uint16_t>(e.a), static_cast<std::uint16_t>(e.b), e.c, e.d);
+    }
+}
+
+} // namespace resl::oracle
diff --git a/src/system/driver/headless/oracle.h b/src/system/driver/headless/oracle.h
new file mode 100644
index 0000000..38bab44
--- /dev/null
+++ b/src/system/driver/headless/oracle.h
@@ -0,0 +1,46 @@
+#pragma once
+
+// Oracle runtime: virtual clock, scripted input and state trace.
+// Everything here replaces wall-clock / SDL behaviour of reSL so that a run
+// is a pure function of (seed, files, script).
+
+#include <chrono>
+#include <cstdint>
+
+namespace resl::oracle {
+
+// Virtual monotonic clock with microsecond resolution.
+struct VirtualClock {
+    using rep = std::int64_t;
+    using period = std::micro;
+    using duration = std::chrono::duration<rep, period>;
+    using time_point = std::chrono::time_point<VirtualClock>;
+    static constexpr bool is_steady = true;
+    static time_point now() noexcept;
+};
+
+// Blocking wait: jump the virtual clock forward (never backwards).
+void advanceTo(VirtualClock::time_point);
+void advanceBy(VirtualClock::duration);
+
+void init(int argc, char* argv[]);
+
+// Called by the scheduler after each task resumption.
+void onTaskResumed(unsigned taskId);
+// Called on every frame boundary (VGAEmulation::flush with a new frame).
+void onFrame();
+
+void onSound(std::uint16_t freq);
+void onStatusMessage(const char*);
+void onTaskAdded(unsigned taskId);
+
+// The game is about to do something undefined (e.g. dereference an invalid
+// rail pointer). The original DOS program reads garbage memory here; reSL
+// crashes. The oracle writes a "U" line, finishes the trace and exits; the
+// TS port must detect the same situation at the same step.
+[[noreturn]] void undefinedBehavior(const char* what);
+
+// Delivers due scripted input events (called from Driver::pollEvent).
+void deliverInput();
+
+} // namespace resl::oracle
