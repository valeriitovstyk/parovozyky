@@ -0,0 +1,167 @@
+#include "video.h"
+
+#include "driver.h"
+#include "oracle.h"
+
+#include <cassert>
+#include <cstring>
+
+namespace resl {
+
+VGAEmulation::VGAEmulation()
+{
+    std::memset(&m_vgaState.mem, 0, sizeof(m_vgaState.mem));
+    m_vgaState.palette = {
+        0xFF55AA00, // Green
+        0xFF000000, // Black
+        0xFFAAAAAA, // Gray
+        0xFF555555, // Dark gray
+        0xFFFFFFFF, // White
+        0xFFFFFF55, // Yellow
+        0xFFAAAA00, // Brown
+        0xFF0055FF, // Blue
+        0xFF0055AA, // Dark blue
+        0xFFFF5500, // Red
+        0xFFAA5500, // Dark red
+        0xFF1AFFFF, // Cyan
+        0xFF00AAAA, // Dark cyan
+        0xFF00FF00, // Light green
+        0xFF00AA00, // Dark green
+        0xFFFFFFFF  // Blinking color (Black/White)
+    };
+}
+
+void VGAEmulation::flush()
+{
+    const ClockT::time_point now = ClockT::now();
+    if (now < m_nextFrameTime)
+        return;
+    m_nextFrameTime = now + std::chrono::microseconds(s_frameUs);
+
+    oracle::onFrame();
+    Driver::instance().pollEvent();
+}
+
+void VGAEmulation::waitVerticalRetrace()
+{
+    const ClockT::time_point now = ClockT::now();
+    if (now < m_nextFrameTime)
+        oracle::advanceTo(m_nextFrameTime);
+    flush();
+}
+
+void VGAEmulation::write(vga::VideoMemPtr memPtr, std::uint8_t color)
+{
+    unsigned offset = memPtr - vga::VIDEO_MEM_START_ADDR;
+    assert(offset < 0x10000);
+
+    switch (m_vgaState.writeMode) {
+    case 0:
+        if (m_vgaState.regPlaneMask && m_vgaState.writeMask) {
+            const std::uint8_t mask = m_vgaState.writeMask;
+            for (int plane = 0; plane < 4; ++plane) {
+                if (!(m_vgaState.regPlaneMask & (1 << plane)))
+                    continue;
+                std::uint8_t& v = m_vgaState.mem[offset][plane];
+                v = (v & ~mask) | (mask & color);
+            }
+        }
+        break;
+    case 1:
+        std::memcpy(&m_vgaState.mem[offset], &m_vgaState.latches,
+                    sizeof(m_vgaState.latches));
+        break;
+
+    case 2:
+        if (m_vgaState.writeMask) {
+            const std::uint8_t mask = m_vgaState.writeMask;
+            for (int plane = 0; plane < 4; ++plane) {
+                std::uint8_t& v = m_vgaState.mem[offset][plane];
+
+                std::uint8_t bitsToSet = mask * (color & 1);
+                switch (m_vgaState.writeOperation) {
+                case vga::WriteOperation::Copy:
+                    break;
+                case vga::WriteOperation::And:
+                    bitsToSet &= v;
+                    break;
+                case vga::WriteOperation::Or:
+                    bitsToSet |= v;
+                    break;
+                case vga::WriteOperation::Xor:
+                    bitsToSet ^= v;
+                    break;
+                }
+                v = (v & ~mask) | bitsToSet;
+                color >>= 1;
+            }
+        }
+        break;
+    };
+}
+
+std::uint8_t VGAEmulation::read(vga::VideoMemPtr memPtr)
+{
+    unsigned offset = memPtr - vga::VIDEO_MEM_START_ADDR;
+    assert(offset < 0x10000);
+    std::memcpy(&m_vgaState.latches, &m_vgaState.mem[offset], sizeof(m_vgaState.latches));
+    assert(m_vgaState.readMode == 0);
+    return m_vgaState.mem[offset][m_vgaState.readPlane];
+}
+
+void VGAEmulation::setWriteMask(std::uint8_t mask) { m_vgaState.writeMask = mask; }
+std::uint8_t VGAEmulation::writeMode() { return m_vgaState.writeMode; }
+
+void VGAEmulation::setMode(std::uint8_t mode)
+{
+    m_vgaState.writeMode = mode & 3;
+    m_vgaState.readMode = (mode >> 2) & 1;
+}
+
+void VGAEmulation::setLineCompareRegister(std::uint16_t y) { m_vgaState.overflowLineCompare = y & 0x1FF; }
+
+void VGAEmulation::setFrameOrigin([[maybe_unused]] std::int16_t x, std::int16_t y)
+{
+    assert(x == 0);
+    m_vgaState.yOrigin = y;
+}
+
+void VGAEmulation::setPlaneMask(std::uint8_t mask) { m_vgaState.regPlaneMask = mask; }
+void VGAEmulation::setReadPlane(std::uint8_t p) { m_vgaState.readPlane = p; }
+void VGAEmulation::setWriteOperation(vga::WriteOperation op) { m_vgaState.writeOperation = op; }
+
+void VGAEmulation::setPaletteItem(std::uint8_t idx, std::uint32_t argb)
+{
+    assert(idx < m_vgaState.palette.size());
+    m_vgaState.palette[idx] = argb | 0xFF000000;
+}
+
+unsigned VGAEmulation::timeToNextFrameMS() const
+{
+    const ClockT::time_point now = ClockT::now();
+    if (now >= m_nextFrameTime)
+        return 0;
+    return static_cast<unsigned>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(m_nextFrameTime - now).count());
+}
+
+void VGAEmulation::renderScreen(std::uint32_t* dst) const
+{
+    const auto pixel = [this](int x, int y) {
+        const std::size_t byte = static_cast<std::size_t>(y) * vga::VIDEO_MEM_ROW_BYTES + x / 8;
+        const int bit = 7 - (x & 7);
+        int c = 0;
+        for (int p = 0; p < 4; ++p)
+            c |= ((m_vgaState.mem[byte & 0xFFFF][p] >> bit) & 1) << p;
+        return m_vgaState.palette[c];
+    };
+    const int split = m_vgaState.overflowLineCompare;
+    for (int y = 0; y < LOGICAL_SCREEN_HEIGHT; ++y) {
+        // rows above the line-compare register come from yOrigin, the rest from address 0
+        const int srcY = y < split ? y + m_vgaState.yOrigin : y - split;
+        for (int x = 0; x < LOGICAL_SCREEN_WIDTH; ++x)
+            dst[y * LOGICAL_SCREEN_WIDTH + x] = pixel(x, srcY);
+    }
+}
+
+} // namespace resl
diff --git a/src/system/driver/headless/video.h b/src/system/driver/headless/video.h
new file mode 100644
index 0000000..e835026
--- /dev/null
+++ b/src/system/driver/headless/video.h
@@ -0,0 +1,84 @@
+#pragma once
+
+#include "oracle.h"
+
+#include <graphics/vga.h>
+
+#include <array>
+#include <cstdint>
+#include <functional>
+
+namespace resl {
+
+// Headless VGA emulation: the video memory is kept (it is cheap and allows
+// screenshots of the oracle), but nothing is shown. Frame timing uses the
+// virtual clock.
+class VGAEmulation {
+public:
+    VGAEmulation();
+
+    VGAEmulation(const VGAEmulation&) = delete;
+    VGAEmulation& operator=(const VGAEmulation&) = delete;
+
+    void requestScreenUpdate() { }
+
+    void flush();
+    void waitVerticalRetrace();
+
+    void setDebugMode(bool) { }
+    bool isDebugMode() const { return false; }
+    void setFullscreenMode(bool) { }
+
+    [[nodiscard]] std::uint8_t read(vga::VideoMemPtr);
+    void write(vga::VideoMemPtr, std::uint8_t color);
+
+    void setWriteMask(std::uint8_t);
+
+    [[nodiscard]] std::uint8_t writeMode();
+    void setMode(std::uint8_t);
+
+    void setPlaneMask(std::uint8_t);
+    void setReadPlane(std::uint8_t);
+    void setWriteOperation(vga::WriteOperation);
+
+    void setLineCompareRegister(std::uint16_t);
+    void setFrameOrigin(std::int16_t x, std::int16_t y);
+
+    void setPaletteItem(std::uint8_t idx, std::uint32_t argb);
+
+    unsigned timeToNextFrameMS() const;
+
+    template <typename T>
+    void addOverlay(T&&) { }
+
+    std::int64_t nextFrameTimeUs() const { return m_nextFrameTime.time_since_epoch().count(); }
+
+    // Renders the visible screen (640x350, as shown to the user) to ARGB.
+    void renderScreen(std::uint32_t* dst) const;
+
+    // reSL uses 60 FPS (the original VGA mode is 70 Hz). See docs/fidelity.md.
+    static constexpr int s_FPS = 60;
+    static constexpr std::int64_t s_frameUs = 1000000 / s_FPS;
+
+private:
+    using ClockT = oracle::VirtualClock;
+
+    struct VGAState {
+        std::uint8_t latches[4] = {};
+        std::uint8_t writeMask = 0;
+        std::uint8_t writeMode = 2;
+        vga::WriteOperation writeOperation = vga::WriteOperation::Copy;
+        std::uint8_t readMode = 0;
+        std::uint8_t readPlane = 0;
+        std::uint8_t regPlaneMask = 0xF;
+        std::uint16_t overflowLineCompare = 0;
+        std::int16_t yOrigin = 0;
+        std::array<std::uint32_t, 16> palette;
+        std::uint8_t mem[0x10000][4];
+    };
+
+    VGAState m_vgaState;
+    ClockT::time_point m_nextFrameTime = {};
+};
+
+} // namespace resl
