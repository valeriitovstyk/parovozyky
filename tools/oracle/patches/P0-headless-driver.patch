@@ -0,0 +1,417 @@
+#include "state_dump.h"
+
+#include "driver.h"
+
+#include <game/demo.h>
+#include <game/entrance.h>
+#include <game/header.h>
+#include <game/header_field.h>
+#include <game/melody.h>
+#include <game/mouse/construction_mode.h>
+#include <game/mouse/management_mode.h>
+#include <game/mouse/mouse.h>
+#include <game/mouse/state.h>
+#include <game/player_name.h>
+#include <game/rail.h>
+#include <game/resources/semaphore_glyph.h>
+#include <game/road_construction.h>
+#include <game/semaphore.h>
+#include <game/static_object.h>
+#include <game/switch.h>
+#include <game/train.h>
+#include <system/keyboard.h>
+#include <ui/components/dialog.h>
+#include <ui/game_over.h>
+
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace resl {
+
+// Variables that are file-local in reSL; P5 makes them visible to the oracle.
+extern std::int16_t g_gameTime;
+extern std::int8_t g_footerMessageTimeout;
+extern std::uint8_t g_previousMouseButtonState;
+extern std::uint8_t g_lastProcessedTrain;
+extern std::uint8_t g_lastProcessedCarriages[20];
+extern char g_demoFileName[16];
+extern MsgMouseEvent g_demoMouseMsg;
+
+std::uint32_t oracleRandState();
+void oracleTimerState(std::int32_t out[5]);
+
+} // namespace resl
+
+namespace resl::oracle {
+
+namespace {
+
+    using Section = std::pair<const char*, std::vector<std::int32_t>>;
+
+    class Writer {
+    public:
+        void section(const char* name) { m_sections.push_back({ name, {} }); }
+        void put(std::int64_t v) { m_sections.back().second.push_back(static_cast<std::int32_t>(v)); }
+        const std::vector<Section>& sections() const { return m_sections; }
+
+    private:
+        std::vector<Section> m_sections;
+    };
+
+    constexpr int kRailCount = 11 * 11 * 6;
+
+    std::int32_t railId(const Rail* r)
+    {
+        if (!r)
+            return 0;
+        if (r == g_disabledSwitchPath)
+            return 1;
+        const Rail* first = &g_rails[0][0][0];
+        if (r >= first && r < first + kRailCount)
+            return 2 + static_cast<std::int32_t>(r - first);
+        for (int i = 0; i < 9; ++i) {
+            if (r == &g_entrances[i].rail)
+                return 2 + kRailCount + i;
+        }
+        return -1; // must never happen
+    }
+
+    std::int32_t carriageId(const Carriage* c)
+    {
+        if (!c)
+            return 0;
+        for (int t = 0; t < 20; ++t) {
+            for (int i = 0; i < 5; ++i) {
+                if (c == &g_trains[t].carriages[i])
+                    return t * 5 + i + 1;
+            }
+        }
+        return -1;
+    }
+
+    std::int32_t trainId(const Train* t)
+    {
+        if (!t)
+            return -1;
+        return static_cast<std::int32_t>(t - &g_trains[0]);
+    }
+
+    void putRail(Writer& w, const Rail& r)
+    {
+        w.put(r.x);
+        w.put(r.y);
+        w.put(r.type);
+        w.put(r.minPathStep);
+        w.put(r.maxPathStep);
+        for (int i = 0; i < 3; ++i)
+            w.put(r.semSlotIdByDirection[i]);
+        for (int i = 0; i < 2; ++i) {
+            w.put(railId(r.connections[i].rail));
+            w.put(r.connections[i].slot);
+        }
+    }
+
+    void putLocation(Writer& w, const Location& l)
+    {
+        w.put(l.pathStep);
+        w.put(l.forwardDirection);
+        w.put(railId(l.rail));
+    }
+
+    void putConnection(Writer& w, const RailConnection& c)
+    {
+        w.put(railId(c.rail));
+        w.put(c.slot);
+    }
+
+    void putRailInfo(Writer& w, const RailInfo& ri)
+    {
+        w.put(ri.roadTypeMask);
+        w.put(ri.tileX);
+        w.put(ri.tileY);
+        w.put(ri.railType);
+        w.put(ri.year_8);
+    }
+
+    template <typename Q, typename F>
+    void putQueue(Writer& w, const Q& q, F&& putItem)
+    {
+        w.put(static_cast<std::int64_t>(q.size()));
+        w.put(q.hasWaitingTask());
+        q.forEach(putItem);
+    }
+
+    void collect(Writer& w)
+    {
+        std::int32_t timer[5];
+        oracleTimerState(timer);
+        MouseDriver& md = Driver::instance().mouse();
+
+        w.section("sys");
+        for (std::int32_t v : timer)
+            w.put(v);
+        w.put(static_cast<std::int32_t>(oracleRandState()));
+        w.put(g_lastKeyPressed);
+        w.put(g_lastKeyCode);
+        w.put(md.buttonState());
+        w.put(md.cursorX());
+        w.put(md.cursorY());
+        w.put(md.cursorVisible());
+
+        w.section("game");
+        w.put(g_gameTime);
+        w.put(g_isDemoMode);
+        w.put(g_gameOver);
+        w.put(g_soundEnabled);
+        w.put(g_previousMouseButtonState);
+        w.put(g_footerMessageTimeout);
+        w.put(g_lastProcessedTrain);
+        for (std::uint8_t v : g_lastProcessedCarriages)
+            w.put(v);
+        w.put(g_entranceCount);
+        w.put(g_railRoadCount);
+        w.put(g_nSwitches);
+        w.put(g_semaphoreCount);
+        w.put(g_newSemaphoreCount);
+        w.put(g_erasedSemaphoreCount);
+        for (std::uint8_t v : g_cuttingDownStaticObjectsByKind)
+            w.put(v);
+        w.put(g_demoFileName[5]);
+        w.put(g_demoMouseMsg.action);
+        w.put(g_demoMouseMsg.x);
+        w.put(g_demoMouseMsg.y);
+        w.put(mouse::g_state.mode == nullptr                  ? 0
+                  : mouse::g_state.mode == &mouse::g_modeManagement ? 1
+                                                                    : 2);
+        w.put(mouse::g_modeManagement.x);
+        w.put(mouse::g_modeManagement.y);
+        w.put(mouse::g_modeConstruction.x);
+        w.put(mouse::g_modeConstruction.y);
+        putRailInfo(w, mouse::g_railCursorState);
+        for (char c : g_playerName)
+            w.put(static_cast<std::uint8_t>(c));
+
+        w.section("headers");
+        for (const HeaderField& h : g_headers) {
+            w.put(h.x);
+            w.put(h.y);
+            w.put(h.valueLimit);
+            w.put(h.nDigits);
+            w.put(h.curAnimatingDigit);
+            w.put(h.value);
+            w.put(h.yScroll);
+            for (std::uint8_t d : h.digitValues)
+                w.put(d);
+        }
+
+        w.section("queues");
+        putQueue(w, g_mouseMsgQueue, [&w](const MsgMouseEvent& e) {
+            w.put(e.action);
+            w.put(e.x);
+            w.put(e.y);
+        });
+        putQueue(w, g_railConstructionMsgQueue, [&w](const RailInfo& ri) { putRailInfo(w, ri); });
+        putQueue(w, g_headerAnimationTaskQueue, [&w](const HeaderValueChangeRequest& r) {
+            w.put(r.delta);
+            w.put(static_cast<int>(r.fieldId));
+            w.put(r.value);
+        });
+
+        w.section("dialogs");
+        for (const Dialog& d : g_dialogs) {
+            w.put(d.x);
+            for (std::int16_t y : d.itemY)
+                w.put(y);
+            w.put(d.itemWidth);
+        }
+        {
+            const char* item = g_dialogs[static_cast<int>(DialogType::Pause)].itemNames[1];
+            w.put(!std::strcmp(item, "Save") ? 0 : !std::strcmp(item, "  OK") ? 1 : 2);
+        }
+
+        w.section("rails");
+        for (int x = 0; x < 11; ++x)
+            for (int y = 0; y < 11; ++y)
+                for (int t = 0; t < 6; ++t)
+                    putRail(w, g_rails[x][y][t]);
+
+        w.section("road");
+        for (std::uint16_t i = 0; i < g_railRoadCount; ++i)
+            putRailInfo(w, g_railRoad[i]);
+        for (int x = 0; x < 11; ++x)
+            for (int y = 0; y < 11; ++y)
+                w.put(g_railroadTypeMasks[x][y]);
+
+        w.section("switches");
+        for (std::uint16_t i = 0; i < g_nSwitches; ++i) {
+            const Switch& s = g_switches[i];
+            w.put(s.x);
+            w.put(s.y);
+            putConnection(w, s.exit);
+            putConnection(w, s.entry);
+            putConnection(w, s.disabledPath);
+            w.put(s.adjacentSwitchIdx);
+        }
+
+        w.section("semaphores");
+        for (std::uint16_t i = 0; i < g_semaphoreCount; ++i) {
+            const Semaphore& s = g_semaphores[i];
+            w.put(railId(s.rail));
+            w.put(static_cast<int>(s.type));
+            w.put(s.isRed);
+            w.put(s.isRightDirection);
+            w.put(s.pixelX);
+            w.put(s.pixelY);
+            w.put(s.glyph ? static_cast<std::int32_t>(s.glyph - &g_semaphoreGlyphs[0][0]) : -1);
+        }
+
+        w.section("entrances");
+        for (const Entrance& e : g_entrances) {
+            w.put(e.bgColor);
+            w.put(e.fgColor);
+            w.put(e.entranceRailInfoIdx);
+            w.put(e.waitingTrainsCount);
+            putRail(w, e.rail);
+        }
+
+        w.section("objects");
+        for (const StaticObject& o : g_staticObjects) {
+            w.put(o.x);
+            w.put(o.y);
+            w.put(static_cast<int>(o.kind));
+            w.put(o.type);
+            w.put(o.color);
+            w.put(o.creationYear);
+        }
+
+        w.section("trains");
+        for (const Train& t : g_trains) {
+            w.put(t.isFreeSlot);
+            w.put(t.carriageCnt);
+            w.put(t.drawingChainIdx);
+            w.put(t.needToRedraw);
+            w.put(t.isActualPosition);
+            w.put(t.speed);
+            w.put(t.maxSpeed);
+            w.put(t.headCarriageIdx);
+            w.put(t.movementDebt);
+            w.put(t.year);
+            w.put(t.lastMovementTime);
+            putLocation(w, t.head);
+            putLocation(w, t.tail);
+            for (const Carriage& c : t.carriages) {
+                w.put(carriageId(c.next));
+                w.put(c.drawingPriority);
+                w.put(trainId(c.train));
+                w.put(c.dstEntranceIdx);
+                w.put(static_cast<int>(c.type));
+                w.put(c.direction);
+                w.put(c.x_direction);
+                putLocation(w, c.location);
+                w.put(c.rect.x1);
+                w.put(c.rect.y1);
+                w.put(c.rect.x2);
+                w.put(c.rect.y2);
+            }
+        }
+
+        w.section("chains");
+        w.put(g_collidedTrainsArrayLen);
+        for (std::uint16_t i = 0; i < g_collidedTrainsArrayLen; ++i) {
+            w.put(carriageId(g_collidedTrainsArray[i].first));
+            w.put(carriageId(g_collidedTrainsArray[i].second));
+        }
+        w.put(g_trainDrawingChainLen);
+        for (std::uint16_t i = 0; i < g_trainDrawingChainLen; ++i) {
+            int guard = 0;
+            for (const Carriage* c = g_trainDrawingChains[i]; c && guard < 200; c = c->next, ++guard)
+                w.put(carriageId(c));
+            w.put(0);
+        }
+        w.put(g_needToRedrawTrains);
+    }
+
+    std::uint32_t fnv(std::uint32_t h, std::uint32_t v)
+    {
+        h ^= v;
+        return h * 16777619u;
+    }
+
+} // namespace
+
+std::uint32_t stateHash()
+{
+    Writer w;
+    collect(w);
+    std::uint32_t h = 2166136261u;
+    for (const Section& s : w.sections()) {
+        h = fnv(h, static_cast<std::uint32_t>(s.second.size()));
+        for (std::int32_t v : s.second)
+            h = fnv(h, static_cast<std::uint32_t>(v));
+    }
+    return h;
+}
+
+int entrancesBeforeRails()
+{
+    return reinterpret_cast<std::uintptr_t>(&g_entrances[0].rail) <
+        reinterpret_cast<std::uintptr_t>(&g_rails[0][0][0]);
+}
+
+namespace {
+
+    std::string toJson(const std::vector<const Section*>& sections)
+    {
+        std::string out = "{";
+        bool firstSection = true;
+        for (const Section* s : sections) {
+            if (!firstSection)
+                out += ',';
+            firstSection = false;
+            out += '"';
+            out += s->first;
+            out += "\":[";
+            for (std::size_t i = 0; i < s->second.size(); ++i) {
+                if (i)
+                    out += ',';
+                out += std::to_string(s->second[i]);
+            }
+            out += ']';
+        }
+        out += '}';
+        return out;
+    }
+
+    std::vector<Section> g_lastDelta;
+
+} // namespace
+
+std::string dumpStateJson()
+{
+    Writer w;
+    collect(w);
+    std::vector<const Section*> all;
+    for (const Section& s : w.sections())
+        all.push_back(&s);
+    return toJson(all);
+}
+
+std::string dumpStateDeltaJson()
+{
+    Writer w;
+    collect(w);
+    std::vector<const Section*> changed;
+    const std::vector<Section>& cur = w.sections();
+    for (std::size_t i = 0; i < cur.size(); ++i) {
+        if (i >= g_lastDelta.size() || g_lastDelta[i].second != cur[i].second)
+            changed.push_back(&cur[i]);
+    }
+    std::string res = toJson(changed);
+    g_lastDelta = cur;
+    return res;
+}
+
+} // namespace resl::oracle
