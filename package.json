{
  "name": "parovozyky",
  "version": "1.0.0",
  "description": "Паровозики — графічна гра в браузері з оригінальною графікою",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @parovozyky/app dev",
    "build": "pnpm --filter @parovozyky/app build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "oracle:build": "bash tools/oracle/build.sh",
    "oracle:golden": "node tools/oracle/golden.mjs",
    "extract": "bash tools/extract/extract.sh",
    "test:golden": "vitest run --project golden",
    "fuzz": "vitest run --project fuzz",
    "test:screens": "vitest run --project oracle",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=.tools/ms-playwright playwright test --project smoke",
    "perf": "PLAYWRIGHT_BROWSERS_PATH=.tools/ms-playwright playwright test --project perf --reporter=list",
    "screens": "PLAYWRIGHT_BROWSERS_PATH=.tools/ms-playwright playwright test --project screens --workers=1",
    "level": "PLAYWRIGHT_HTML_OPEN=never PLAYWRIGHT_BROWSERS_PATH=.tools/ms-playwright playwright test --project level --reporter=list,html",
    "replay": "sh -c 'REPLAY=\"$0\" vitest run --project oracle tests/oracle/replay.test.ts'",
    "e2e:dist": "pnpm build && E2E_DIST=1 PLAYWRIGHT_BROWSERS_PATH=.tools/ms-playwright playwright test --project smoke",
    "test:all": "pnpm check && pnpm test:golden && pnpm test:screens && pnpm e2e && pnpm screens && pnpm perf"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
